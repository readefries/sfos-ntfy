[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Name=ntfy
Comment=Push notifications from ntfy servers
Icon=harbour-ntfy
Exec=harbour-ntfy
# Notification taps call this (see nl.readefries.harbourntfy.ui.service); Sailjail lets the app own it.
X-Maemo-Service=nl.readefries.harbourntfy.ui
X-Maemo-Object-Path=/

[X-Sailjail]
# The UI only talks to harbour-ntfy-daemon. Owning OrganizationName.ApplicationName on D-Bus
# (nl.readefries.harbourntfy, the daemon's name) is what allows it to talk to the daemon.
Permissions=
OrganizationName=nl.readefries
ApplicationName=harbourntfy
