[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Name=ntfy
Comment=Push notifications from ntfy servers
Icon=harbour-ntfy
Exec=harbour-ntfy
# With X-Maemo-Service the launcher starts the app through D-Bus activation of this name (see
# nl.readefries.harbourntfy.ui.service) and calls com.nokia.MApplicationIf.launch on /org/maemo/m,
# which shows the window. Notification taps call openSubscription on /. Declaring the service here
# is also what lets the sandboxed app own the name.
X-Maemo-Service=nl.readefries.harbourntfy.ui
X-Maemo-Object-Path=/

[X-Sailjail]
# The UI only talks to harbour-ntfy-daemon. Owning OrganizationName.ApplicationName on D-Bus
# (nl.readefries.harbourntfy, the daemon's name) is what allows it to talk to the daemon.
Permissions=
OrganizationName=nl.readefries
ApplicationName=harbourntfy
